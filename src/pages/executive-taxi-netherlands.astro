---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Executive Taxi Netherlands for Business Trips | Pickupr"
  description="Reserve executive taxi service in the Netherlands with private chauffeur comfort, fixed fare confirmation, and reliable scheduling for board meetings, airports, and VIP itineraries."
  canonical="/executive-taxi-netherlands"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Executive Taxi Netherlands",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Executive Taxi Netherlands for Business Trips | Pickupr",
        url: "/executive-taxi-netherlands",
        description: "Reserve executive taxi service in the Netherlands with private chauffeur comfort, fixed fare confirmation, and reliable scheduling for board meetings, airports, and VIP itineraries.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Executive Taxi Netherlands online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Executive Taxi Netherlands online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Executive Taxi Netherlands for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Executive Taxi Netherlands is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
