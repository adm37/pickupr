---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Business Taxi Netherlands for Executive Travel | Pickupr"
  description="Reserve business taxi Netherlands service for executive meetings, airport runs, and private corporate transfers with fixed fares."
  canonical="/business-taxi-netherlands"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Business Taxi Netherlands",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Business Taxi Netherlands for Executive Travel | Pickupr",
        url: "/business-taxi-netherlands",
        description: "Reserve business taxi Netherlands service for executive meetings, airport runs, and private corporate transfers with fixed fares.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Business Taxi Netherlands online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Business Taxi Netherlands online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Business Taxi Netherlands for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Business Taxi Netherlands is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
