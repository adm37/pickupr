---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Eindhoven to Paris Taxi Private Transfer Service | Pickupr"
  description="Book Eindhoven to Paris taxi with private long-distance transfer, fixed-fare transparency, and direct online confirmation."
  canonical="/eindhoven-to-paris-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Eindhoven to Paris Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Eindhoven to Paris Taxi Private Transfer Service | Pickupr",
        url: "/eindhoven-to-paris-taxi",
        description: "Book Eindhoven to Paris taxi with private long-distance transfer, fixed-fare transparency, and direct online confirmation.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Eindhoven to Paris Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Eindhoven to Paris Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Eindhoven to Paris Taxi for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Eindhoven to Paris Taxi is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
