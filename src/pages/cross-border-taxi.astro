---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Cross Border Taxi Transfers in Europe | Pickupr"
  description="Book Cross Border Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/cross-border-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Cross Border Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Cross Border Taxi | Pickupr",
        url: "/cross-border-taxi",
        description: "Book Cross Border Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Cross Border Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Cross Border Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can Cross Border Taxi include cross-border travel support?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Cross Border Taxi, we confirm route requirements in advance so your cross-border transfer runs smoothly.",
            },
          },
        ],
      },
    ],
  }}
/>
