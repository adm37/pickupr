---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Schiphol Airport Private Transfer Service | Pickupr"
  description="Plan your Schiphol airport private transfer with clear fixed fares, direct booking confirmation, and professional pickup coordination for arrivals, departures, and business itineraries."
  canonical="/schiphol-airport-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Schiphol Airport Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Schiphol Airport Private Transfer Service | Pickupr",
        url: "/schiphol-airport-transfer",
        description: "Plan your Schiphol airport private transfer with clear fixed fares, direct booking confirmation, and professional pickup coordination for arrivals, departures, and business itineraries.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Schiphol Airport Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Schiphol Airport Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Schiphol Airport Transfer?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Schiphol Airport Transfer, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
