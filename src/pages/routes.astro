---
import '../index.css';
import { ALL_CITY_ROUTES } from '../lib/cityLandingRoutes';
import { KEYWORD_LANDING_ROUTES } from '../lib/keywordLandingRoutes';

const siteBase = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '');
const canonical = siteBase ? `${siteBase}/routes` : '/routes';

function groupByFirstLetter<T extends { city?: string; keyword?: string }>(items: T[], key: 'city' | 'keyword') {
  const sorted = items.slice().sort((a, b) => {
    const left = (a[key] || '').toString();
    const right = (b[key] || '').toString();
    return left.localeCompare(right, 'en', { sensitivity: 'base' });
  });

  return sorted.reduce((acc, item) => {
    const value = (item[key] || '').toString();
    const letter = value.charAt(0).toUpperCase() || '#';
    if (!acc.has(letter)) acc.set(letter, [] as T[]);
    acc.get(letter)!.push(item);
    return acc;
  }, new Map<string, T[]>());
}

const cityGroups = groupByFirstLetter(ALL_CITY_ROUTES, 'city');
const cityLetters = Array.from(cityGroups.keys()).sort((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' }));

const keywordGroups = groupByFirstLetter(KEYWORD_LANDING_ROUTES, 'keyword');
const keywordLetters = Array.from(keywordGroups.keys()).sort((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' }));
const routesSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'All Transfer Routes and Destination Pages | Pickupr',
      url: canonical,
      description: 'Master index for city transfer routes and keyword landing pages.',
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      itemListElement: [...ALL_CITY_ROUTES, ...KEYWORD_LANDING_ROUTES].slice(0, 300).map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: (siteBase || '') + item.pathname,
        name: 'keyword' in item ? item.keyword : `${item.origin} to ${item.city}`,
      })),
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Transfer Routes and Destination Pages | Pickupr</title>
    <meta name="description" content="Complete route index for Pickupr including all city destinations and airport transfer keyword pages." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="All Transfer Routes and Destination Pages | Pickupr" />
    <meta property="og:description" content="Crawlable index of all route pages on Pickupr." />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="All Transfer Routes and Destination Pages | Pickupr" />
    <meta name="twitter:description" content="Crawlable index of all route pages on Pickupr." />
    <script type="application/ld+json" set:html={JSON.stringify(routesSchema)}></script>
  </head>
  <body class="bg-zinc-950 text-zinc-100">
    <main class="mx-auto max-w-7xl px-6 py-12 md:py-16">
      <header class="mb-10 border-b border-zinc-800 pb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">Pickupr</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">All routes</h1>
        <p class="mt-3 max-w-3xl text-zinc-400">
          Central route index for faster discovery by users and search crawlers.
          City routes: <strong class="text-zinc-100">{ALL_CITY_ROUTES.length}</strong>.
          Keyword routes: <strong class="text-zinc-100">{KEYWORD_LANDING_ROUTES.length}</strong>.
        </p>
      </header>

      <section class="mb-12">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-2xl font-black tracking-tight">City destinations</h2>
          <a href="/destinations" class="text-sm font-semibold text-emerald-300 hover:text-emerald-200">Open city-only overview</a>
        </div>
        <div class="mb-5 flex flex-wrap gap-2">
          {cityLetters.map((letter) => (
            <a href={`#city-${letter}`} class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold text-zinc-200 transition hover:border-emerald-500 hover:text-white">
              {letter}
            </a>
          ))}
        </div>

        <div class="space-y-9">
          {cityLetters.map((letter) => (
            <article id={`city-${letter}`}>
              <h3 class="text-xl font-black tracking-tight text-white">{letter}</h3>
              <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {cityGroups.get(letter)!.map((route) => (
                  <li>
                    <a href={route.pathname} class="block rounded-lg border border-zinc-800 bg-zinc-900/60 px-4 py-3 text-sm text-zinc-200 transition hover:border-emerald-500 hover:text-white">
                      {route.origin} to {route.city} ({route.countryCode})
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-black tracking-tight">Keyword transfer pages</h2>
        <div class="mb-5 mt-4 flex flex-wrap gap-2">
          {keywordLetters.map((letter) => (
            <a href={`#keyword-${letter}`} class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold text-zinc-200 transition hover:border-emerald-500 hover:text-white">
              {letter}
            </a>
          ))}
        </div>

        <div class="space-y-9">
          {keywordLetters.map((letter) => (
            <article id={`keyword-${letter}`}>
              <h3 class="text-xl font-black tracking-tight text-white">{letter}</h3>
              <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {keywordGroups.get(letter)!.map((route) => (
                  <li>
                    <a href={route.pathname} class="block rounded-lg border border-zinc-800 bg-zinc-900/60 px-4 py-3 text-sm text-zinc-200 transition hover:border-emerald-500 hover:text-white">
                      {route.keyword}
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>