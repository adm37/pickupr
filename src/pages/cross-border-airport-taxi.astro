---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Cross Border Airport Taxi Across Benelux | Pickupr"
  description="Reserve a cross-border airport taxi across the Netherlands, Belgium, and nearby hubs with fixed fare clarity, direct booking confirmation, and private chauffeur comfort door to door."
  canonical="/cross-border-airport-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Cross Border Airport Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Cross Border Airport Taxi Across Benelux | Pickupr",
        url: "/cross-border-airport-taxi",
        description: "Reserve a cross-border airport taxi across the Netherlands, Belgium, and nearby hubs with fixed fare clarity, direct booking confirmation, and private chauffeur comfort door to door.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Cross Border Airport Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Cross Border Airport Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Cross Border Airport Taxi?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Cross Border Airport Taxi, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
