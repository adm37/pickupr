---
import '../index.css';
import { ALL_CITY_ROUTES } from '../lib/cityLandingRoutes';

const siteBase = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '');

const routes = ALL_CITY_ROUTES
  .slice()
  .sort((a, b) => a.city.localeCompare(b.city, 'en', { sensitivity: 'base' }));

const groupedRoutes = routes.reduce((acc, route) => {
  const letter = route.city.charAt(0).toUpperCase();
  if (!acc.has(letter)) {
    acc.set(letter, [] as typeof routes);
  }
  acc.get(letter)!.push(route);
  return acc;
}, new Map<string, typeof routes>());

const letters = Array.from(groupedRoutes.keys()).sort((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' }));

const canonical = siteBase ? `${siteBase}/destinations` : '/destinations';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Transfer Destinations | Pickupr</title>
    <meta name="description" content="Browse all Pickupr airport transfer destinations and route pages across the Netherlands, Belgium, Germany, and France." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="All Transfer Destinations | Pickupr" />
    <meta property="og:description" content="Direct links to all city transfer routes from Schiphol and Amsterdam." />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-zinc-950 text-zinc-100">
    <main class="mx-auto max-w-7xl px-6 py-12 md:py-16">
      <header class="mb-10 border-b border-zinc-800 pb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">Pickupr</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">All destinations</h1>
        <p class="mt-3 max-w-3xl text-zinc-400">
          Browse all transfer routes. This page helps visitors and search crawlers discover every destination.
          Total routes: <strong class="text-zinc-100">{routes.length}</strong>.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {letters.map((letter) => (
            <a href={`#letter-${letter}`} class="rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-xs font-semibold text-zinc-200 transition hover:border-emerald-500 hover:text-white">
              {letter}
            </a>
          ))}
        </div>
      </header>

      <section class="space-y-10">
        {letters.map((letter) => (
          <article id={`letter-${letter}`}>
            <h2 class="text-2xl font-black tracking-tight text-white">{letter}</h2>
            <ul class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
              {groupedRoutes.get(letter)!.map((route) => (
                <li>
                  <a href={route.pathname} class="block rounded-lg border border-zinc-800 bg-zinc-900/60 px-4 py-3 text-sm text-zinc-200 transition hover:border-emerald-500 hover:text-white">
                    {route.origin} to {route.city} ({route.countryCode})
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
