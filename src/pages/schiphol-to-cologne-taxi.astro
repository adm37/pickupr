---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Schiphol to Cologne Taxi | Pickupr"
  description="Book Schiphol to Cologne Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/schiphol-to-cologne-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Schiphol to Cologne Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Schiphol to Cologne Taxi | Pickupr",
        url: "/schiphol-to-cologne-taxi",
        description: "Book Schiphol to Cologne Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Schiphol to Cologne Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Schiphol to Cologne Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Schiphol to Cologne Taxi for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Schiphol to Cologne Taxi is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
