---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Schiphol Airport to Bonn Taxi | Pickupr"
  description="Book Schiphol Airport to Bonn Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/schiphol-airport-to-bonn-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Schiphol Airport to Bonn Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Schiphol Airport to Bonn Taxi | Pickupr",
        url: "/schiphol-airport-to-bonn-taxi",
        description: "Book Schiphol Airport to Bonn Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Schiphol Airport to Bonn Taxi online?",
