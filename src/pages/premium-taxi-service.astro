---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Premium Taxi Service for Airport and Business | Pickupr"
  description="Book premium taxi service for executive meetings, airport pickups, and private city travel with transparent pricing and direct confirmation."
  canonical="/premium-taxi-service"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Premium Taxi Service",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Premium Taxi Service for Airport and Business | Pickupr",
        url: "/premium-taxi-service",
        description: "Book premium taxi service for executive meetings, airport pickups, and private city travel with transparent pricing and direct confirmation.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Premium Taxi Service online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Premium Taxi Service online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Premium Taxi Service for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Premium Taxi Service is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
