---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Taxi to Rotterdam Airport Fixed Fare Transfer | Pickupr"
  description="Book a taxi to Rotterdam Airport with private transport, fixed fare visibility, and dependable timing for early departures, business flights, and stress-free terminal arrivals."
  canonical="/taxi-to-rotterdam-airport"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Taxi to Rotterdam Airport",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Taxi to Rotterdam Airport Fixed Fare Transfer | Pickupr",
        url: "/taxi-to-rotterdam-airport",
        description: "Book a taxi to Rotterdam Airport with private transport, fixed fare visibility, and dependable timing for early departures, business flights, and stress-free terminal arrivals.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Taxi to Rotterdam Airport online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Taxi to Rotterdam Airport online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Taxi to Rotterdam Airport?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Taxi to Rotterdam Airport, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
