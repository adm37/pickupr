---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="VIP Taxi Service | Private Transfer | Pickupr"
  description="Book VIP Taxi Service with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/vip-taxi-service"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "VIP Taxi Service",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "VIP Taxi Service | Pickupr",
        url: "/vip-taxi-service",
        description: "Book VIP Taxi Service with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book VIP Taxi Service online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book VIP Taxi Service online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book VIP Taxi Service for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. VIP Taxi Service is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
