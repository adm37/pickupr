---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Europe Taxi Transfer | Pickupr"
  description="Book Europe Taxi Transfer with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/europe-taxi-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Europe Taxi Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Europe Taxi Transfer | Pickupr",
        url: "/europe-taxi-transfer",
        description: "Book Europe Taxi Transfer with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Europe Taxi Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Europe Taxi Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can Europe Taxi Transfer include cross-border travel support?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Europe Taxi Transfer, we confirm route requirements in advance so your cross-border transfer runs smoothly.",
            },
          },
        ],
      },
    ],
  }}
/>
