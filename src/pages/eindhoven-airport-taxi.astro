---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Eindhoven Airport Taxi with Private Pickup | Pickupr"
  description="Book Eindhoven Airport taxi service with private pickup, fixed-fare transparency, and direct online confirmation for smooth travel days."
  canonical="/eindhoven-airport-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Eindhoven Airport Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Eindhoven Airport Taxi with Private Pickup | Pickupr",
        url: "/eindhoven-airport-taxi",
        description: "Book Eindhoven Airport taxi service with private pickup, fixed-fare transparency, and direct online confirmation for smooth travel days.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Eindhoven Airport Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Eindhoven Airport Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Eindhoven Airport Taxi?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Eindhoven Airport Taxi, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
