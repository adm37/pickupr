---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="International Taxi Service for Europe Routes | Pickupr"
  description="Book an international taxi service for Europe routes with private chauffeur comfort, fixed fare transparency, and direct confirmation for business travel, airport pickups, and long-distance trips."
  canonical="/international-taxi-service"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "International Taxi Service",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "International Taxi Service for Europe Routes | Pickupr",
        url: "/international-taxi-service",
        description: "Book an international taxi service for Europe routes with private chauffeur comfort, fixed fare transparency, and direct confirmation for business travel, airport pickups, and long-distance trips.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book International Taxi Service online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book International Taxi Service online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can International Taxi Service include cross-border travel support?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For International Taxi Service, we confirm route requirements in advance so your cross-border transfer runs smoothly.",
            },
          },
        ],
      },
    ],
  }}
/>
