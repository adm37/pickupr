---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Rotterdam Airport Taxi and Chauffeur Transfer | Pickupr"
  description="Reserve Rotterdam Airport taxi and chauffeur transfer service with fixed pricing, private rides, and direct booking confirmation."
  canonical="/rotterdam-airport-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Rotterdam Airport Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Rotterdam Airport Taxi and Chauffeur Transfer | Pickupr",
        url: "/rotterdam-airport-taxi",
        description: "Reserve Rotterdam Airport taxi and chauffeur transfer service with fixed pricing, private rides, and direct booking confirmation.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Rotterdam Airport Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Rotterdam Airport Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Rotterdam Airport Taxi?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Rotterdam Airport Taxi, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
