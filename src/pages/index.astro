---
import AppPageShell from '../components/AppPageShell.astro';

const siteUrl = 'https://pickupr.com';
const contactPhone = (import.meta.env.PUBLIC_CONTACT_PHONE || '').toString().trim();
const streetAddress = (import.meta.env.PUBLIC_BUSINESS_STREET || 'Amsterdam Business District').toString().trim();
const postalCode = (import.meta.env.PUBLIC_BUSINESS_POSTAL_CODE || '').toString().trim();

const localBusinessSchema = {
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#localbusiness`,
  additionalType: 'https://schema.org/TaxiService',
  name: 'Pickupr',
  url: siteUrl,
  image: `${siteUrl}/hero-airport-transfer.jpg`,
  priceRange: 'EUR 75 - EUR 800',
  areaServed: [
    { '@type': 'Country', name: 'Netherlands' },
    { '@type': 'Country', name: 'Belgium' },
    { '@type': 'Country', name: 'France' },
    { '@type': 'Country', name: 'Germany' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: 'Amsterdam',
    addressRegion: 'Noord-Holland',
    postalCode: postalCode || undefined,
    addressCountry: 'NL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.3676,
    longitude: 4.9041,
  },
  telephone: contactPhone || undefined,
  email: 'bookings@pickupr.com',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
};

const offerCatalogSchema = {
  '@type': 'OfferCatalog',
  name: 'Pickupr chauffeur services',
  itemListElement: [
    {
      '@type': 'Offer',
      name: 'Airport transfer',
      priceCurrency: 'EUR',
      price: '75',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'Hourly chauffeur service',
      priceCurrency: 'EUR',
      price: '120',
      availability: 'https://schema.org/InStock',
    },
  ],
};
---
<AppPageShell
  title="Airport Transfers Netherlands | Private Driver Amsterdam | Pickupr"
  description="Book a reliable private airport transfer in the Netherlands with Pickupr. Schiphol Airport transfers, private drivers, city-to-city rides and chauffeur services from Amsterdam."
  canonical="/"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'TransportationService',
        name: 'Pickupr',
        url: siteUrl,
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        description: 'Private transfer service in the Netherlands with Amsterdam airport transfers, Schiphol pickups, and hourly chauffeurs.',
      },
      {
        '@type': 'Organization',
        name: 'Pickupr',
        url: siteUrl,
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          telephone: contactPhone || undefined,
          email: 'bookings@pickupr.com',
          availableLanguage: ['English', 'Dutch'],
        },
      },
      localBusinessSchema,
      offerCatalogSchema,
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: 'How much does an Amsterdam airport transfer cost?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Pricing depends on route, timing, and vehicle class. Pickupr always shows a fixed all-in quote before checkout for Amsterdam airport transfers and city rides.',
            },
          },
          {
            '@type': 'Question',
            name: 'Do you offer private transfers across the Netherlands?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Yes. Pickupr provides private transfers across the Netherlands, including Schiphol airport transfer routes, Amsterdam pickups, and intercity travel.',
            },
          },
          {
            '@type': 'Question',
            name: 'How far in advance should I book?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'You can book as soon as your schedule is known, but same-day bookings are also possible depending on availability.',
            },
          },
          {
            '@type': 'Question',
            name: 'Do you offer airport transfers to and from Schiphol?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Yes. Pickupr offers Schiphol airport transfer service with private drivers for Amsterdam, other Dutch cities, and selected cross-border routes.',
            },
          },
          {
            '@type': 'Question',
            name: 'Can I pay online or to the driver?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Both options are available. You can complete payment online during booking or choose to pay the driver directly.',
            },
          },
        ],
      },
    ],
  }}
/>
