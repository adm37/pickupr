---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Amsterdam Schiphol Private Transfer Service | Pickupr"
  description="Book an Amsterdam to Schiphol private transfer with fixed fare pricing, direct confirmation, and dependable chauffeur pickup for business flights, family travel, or early departures."
  canonical="/amsterdam-schiphol-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Amsterdam Schiphol Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Amsterdam Schiphol Private Transfer Service | Pickupr",
        url: "/amsterdam-schiphol-transfer",
        description: "Book an Amsterdam to Schiphol private transfer with fixed fare pricing, direct confirmation, and dependable chauffeur pickup for business flights, family travel, or early departures.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Amsterdam Schiphol Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Amsterdam Schiphol Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Amsterdam Schiphol Transfer for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Amsterdam Schiphol Transfer is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
