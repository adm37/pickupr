---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Amsterdam Airport Taxi with Fixed Fare Booking | Pickupr"
  description="Book an Amsterdam Airport taxi with fixed fare pricing, private transfer comfort, and direct confirmation for arrivals and departures."
  canonical="/amsterdam-airport-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Amsterdam Airport Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Amsterdam Airport Taxi with Fixed Fare Booking | Pickupr",
        url: "/amsterdam-airport-taxi",
        description: "Book an Amsterdam Airport taxi with fixed fare pricing, private transfer comfort, and direct confirmation for arrivals and departures.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Amsterdam Airport Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Amsterdam Airport Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Amsterdam Airport Taxi?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Amsterdam Airport Taxi, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
