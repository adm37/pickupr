---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Shuttle to Schiphol Airport with Private Transfer | Pickupr"
  description="Reserve a shuttle to Schiphol Airport with private transfer comfort, direct confirmation, and fixed-fare transport planning."
  canonical="/shuttle-schiphol-airport"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Shuttle Schiphol Airport",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Shuttle to Schiphol Airport with Private Transfer | Pickupr",
        url: "/shuttle-schiphol-airport",
        description: "Reserve a shuttle to Schiphol Airport with private transfer comfort, direct confirmation, and fixed-fare transport planning.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Shuttle Schiphol Airport online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Shuttle Schiphol Airport online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Shuttle Schiphol Airport?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Shuttle Schiphol Airport, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
