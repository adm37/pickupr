---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Airport Transfer to Utrecht With Private Driver | Pickupr"
  description="Book an airport transfer to Utrecht with fixed fare clarity, private chauffeur comfort, and direct confirmation for arrivals, departures, and punctual city connections."
  canonical="/airport-transfer-to-utrecht"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Airport Transfer to Utrecht",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Airport Transfer to Utrecht With Private Driver | Pickupr",
        url: "/airport-transfer-to-utrecht",
        description: "Book an airport transfer to Utrecht with fixed fare clarity, private chauffeur comfort, and direct confirmation for arrivals, departures, and punctual city connections.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Airport transfer to Utrecht online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Airport transfer to Utrecht online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Airport transfer to Utrecht?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Airport transfer to Utrecht, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
