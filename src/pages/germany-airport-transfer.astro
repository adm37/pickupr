---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Germany Airport Transfer and Cross-Border Taxi | Pickupr"
  description="Book Germany airport transfer routes with cross-border private taxi service, fixed-fare visibility, and instant confirmation."
  canonical="/germany-airport-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Germany Airport Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Germany Airport Transfer and Cross-Border Taxi | Pickupr",
        url: "/germany-airport-transfer",
        description: "Book Germany airport transfer routes with cross-border private taxi service, fixed-fare visibility, and instant confirmation.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Germany Airport Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Germany Airport Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Germany Airport Transfer?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Germany Airport Transfer, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
