---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Business Airport Transfer Service Netherlands | Pickupr"
  description="Arrange a business airport transfer in the Netherlands with a private chauffeur, fixed fare confirmation, and reliable pickup planning for meetings, flights, and executive schedules."
  canonical="/business-airport-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Business Airport Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Business Airport Transfer Service Netherlands | Pickupr",
        url: "/business-airport-transfer",
        description: "Arrange a business airport transfer in the Netherlands with a private chauffeur, fixed fare confirmation, and reliable pickup planning for meetings, flights, and executive schedules.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Business Airport Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Business Airport Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Business Airport Transfer?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Business Airport Transfer, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
