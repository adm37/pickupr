---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Taxi to Schiphol Airport with Fixed Fare Booking | Pickupr"
  description="Book a taxi to Schiphol Airport with private pickup service, fixed-fare pricing, and direct online confirmation for departures."
  canonical="/taxi-to-schiphol-airport"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Taxi to Schiphol Airport",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Taxi to Schiphol Airport with Fixed Fare Booking | Pickupr",
        url: "/taxi-to-schiphol-airport",
        description: "Book a taxi to Schiphol Airport with private pickup service, fixed-fare pricing, and direct online confirmation for departures.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Taxi to Schiphol Airport online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Taxi to Schiphol Airport online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Taxi to Schiphol Airport?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Taxi to Schiphol Airport, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
