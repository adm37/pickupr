---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Amsterdam Airport Private Transfer Service | Pickupr"
  description="Book an Amsterdam airport private transfer with fixed fare pricing, direct confirmation, and professional pickup support for departures, arrivals, and smooth city-to-airport travel."
  canonical="/amsterdam-airport-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Amsterdam Airport Private Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Amsterdam Airport Private Transfer Service | Pickupr",
        url: "/amsterdam-airport-transfer",
        description: "Book an Amsterdam airport private transfer with fixed fare pricing, direct confirmation, and professional pickup support for departures, arrivals, and smooth city-to-airport travel.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Amsterdam Airport transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Amsterdam Airport transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Amsterdam Airport transfer?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Amsterdam Airport transfer, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
