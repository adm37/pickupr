---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Corporate Airport Transfer | Pickupr"
  description="Book Corporate Airport Transfer with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/corporate-airport-transfer"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Corporate Airport Transfer",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Corporate Airport Transfer | Pickupr",
        url: "/corporate-airport-transfer",
        description: "Book Corporate Airport Transfer with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Corporate Airport Transfer online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Corporate Airport Transfer online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Corporate Airport Transfer?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Corporate Airport Transfer, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
