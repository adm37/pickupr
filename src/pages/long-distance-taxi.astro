---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Long Distance Taxi | Pickupr"
  description="Book Long Distance Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/long-distance-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Long Distance Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Long Distance Taxi | Pickupr",
        url: "/long-distance-taxi",
        description: "Book Long Distance Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Long Distance Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Long Distance Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Long Distance Taxi for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Long Distance Taxi is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
