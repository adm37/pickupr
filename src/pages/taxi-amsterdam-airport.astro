---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Taxi Amsterdam Airport Private Transfer Service | Pickupr"
  description="Reserve a taxi to Amsterdam Airport with private transfer support, clear fixed pricing, and quick online confirmation from Pickupr."
  canonical="/taxi-amsterdam-airport"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Taxi Amsterdam Airport",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Taxi Amsterdam Airport Private Transfer Service | Pickupr",
        url: "/taxi-amsterdam-airport",
        description: "Reserve a taxi to Amsterdam Airport with private transfer support, clear fixed pricing, and quick online confirmation from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Taxi Amsterdam Airport online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Taxi Amsterdam Airport online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Taxi Amsterdam Airport?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Taxi Amsterdam Airport, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
