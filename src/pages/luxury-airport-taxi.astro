---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Luxury Airport Taxi and Executive Chauffeur | Pickupr"
  description="Book Luxury Airport Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/luxury-airport-taxi"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Luxury Airport Taxi",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Luxury Airport Taxi | Pickupr",
        url: "/luxury-airport-taxi",
        description: "Book Luxury Airport Taxi with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Luxury Airport Taxi online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Luxury Airport Taxi online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Luxury Airport Taxi?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Luxury Airport Taxi, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
