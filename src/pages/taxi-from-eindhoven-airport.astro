---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Taxi from Eindhoven Airport | Pickupr"
  description="Book Taxi from Eindhoven Airport with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/taxi-from-eindhoven-airport"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Taxi from Eindhoven Airport",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Taxi from Eindhoven Airport | Pickupr",
        url: "/taxi-from-eindhoven-airport",
        description: "Book Taxi from Eindhoven Airport with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Taxi from Eindhoven Airport online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Taxi from Eindhoven Airport online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Do you monitor flight arrivals for Taxi from Eindhoven Airport?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. For Taxi from Eindhoven Airport, we monitor flight status and adjust pickup timing when your arrival is delayed.",
            },
          },
        ],
      },
    ],
  }}
/>
