---
import AppPageShell from '../components/AppPageShell.astro';
---

<AppPageShell
  title="Taxi to France | Private Transfer | Pickupr"
  description="Book Taxi to France with private transfer, direct confirmation, and clear fixed-fare details from Pickupr."
  canonical="/taxi-to-france"
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        name: "Taxi to France",
        provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
        serviceType: 'Private airport and long-distance transfer',
        areaServed: ['Netherlands', 'Belgium', 'Germany', 'France'],
        image: ['/hero-airport-transfer.jpg'],
      },
      {
        '@type': 'WebPage',
        name: "Taxi to France | Pickupr",
        url: "/taxi-to-france",
        description: "Book Taxi to France with private transfer, direct confirmation, and clear fixed-fare details from Pickupr.",
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: '/hero-airport-transfer.jpg',
        },
      },
      {
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: "Can I pre-book Taxi to France online?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. You can pre-book Taxi to France online and receive direct confirmation with full route details.",
            },
          },
          {
            '@type': 'Question',
            name: "Can I book Taxi to France for business travel?",
            acceptedAnswer: {
              '@type': 'Answer',
              text: "Yes. Taxi to France is available for business and private travel with fixed-fare clarity and direct confirmation.",
            },
          },
        ],
      },
    ],
  }}
/>
