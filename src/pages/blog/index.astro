---
const posts = [
  {
    href: '/blog/schiphol-airport-to-utrecht-private-transfer',
    title: 'Schiphol to Utrecht private transfer: fixed-price taxi booking guide',
    description: 'Compare transfer options from Schiphol to Utrecht and book a reliable private taxi in minutes.',
  },
  {
    href: '/blog/schiphol-airport-to-rotterdam-private-transfer',
    title: 'Schiphol to Rotterdam private transfer: best routes and booking tips',
    description: 'Plan a fast and comfortable Schiphol to Rotterdam ride with transparent pricing.',
  },
  {
    href: '/blog/schiphol-airport-to-eindhoven-private-transfer',
    title: 'Schiphol to Eindhoven taxi: long-distance private transfer made easy',
    description: 'Everything travelers need to know before booking a private transfer from Schiphol to Eindhoven.',
  },
  {
    href: '/blog/schiphol-airport-to-antwerp-private-transfer',
    title: 'Schiphol to Antwerp taxi: cross-border private transfer guide',
    description: 'Book a smooth airport transfer from Schiphol to Antwerp with door-to-door convenience.',
  },
  {
    href: '/blog/schiphol-airport-to-brussels-private-transfer',
    title: 'Schiphol to Brussels private taxi: travel time, pricing, and booking',
    description: 'Discover the easiest way to travel from Schiphol Airport to Brussels by private taxi.',
  },
  {
    href: '/blog/schiphol-airport-to-lille-private-transfer',
    title: 'Schiphol to Lille private transfer: France route booking guide',
    description: 'How to arrange a reliable Schiphol to Lille taxi with fixed-rate comfort.',
  },
  {
    href: '/blog/schiphol-airport-to-paris-private-transfer',
    title: 'Schiphol to Paris private taxi: premium long-distance airport transfer',
    description: 'Book a direct private transfer from Schiphol to Paris for business and leisure travel.',
  },
  {
    href: '/blog/schiphol-airport-to-cologne-private-transfer',
    title: 'Schiphol to Cologne taxi: Germany private transfer guide',
    description: 'Choose the right private transfer from Schiphol to Cologne with clear booking steps.',
  },
  {
    href: '/blog/schiphol-airport-to-dusseldorf-private-transfer',
    title: 'Schiphol to Dusseldorf private transfer: fast cross-border booking',
    description: 'A practical guide to booking a private taxi from Schiphol to Dusseldorf.',
  },
  {
    href: '/blog/schiphol-airport-to-frankfurt-private-transfer',
    title: 'Schiphol to Frankfurt private taxi: long-haul airport transfer tips',
    description: 'Plan your Schiphol to Frankfurt transfer with fixed pricing and professional drivers.',
  },
  {
    href: '/blog/taxi-amsterdam-airport',
    title: 'Taxi Amsterdam Airport: Private transfer guide for international travelers',
    description: 'Everything you need for a smooth private taxi from Amsterdam Airport to city hotels and beyond.',
  },
  {
    href: '/blog/taxi-eindhoven-airport',
    title: 'Taxi Eindhoven Airport: Book a fast private airport transfer',
    description: 'How to arrange a reliable private transfer from Eindhoven Airport for business or leisure trips.',
  },
  {
    href: '/blog/taxi-rotterdam-airport',
    title: 'Taxi Rotterdam Airport: Private taxi options and travel times',
    description: 'Compare private taxi options from Rotterdam Airport and choose the right transfer for your route.',
  },
  {
    href: '/blog/taxi-the-haque-airport',
    title: 'Taxi The Haque Airport: Private taxi booking tips',
    description: 'A practical airport transfer guide for travelers searching for taxi The Haque Airport options.',
  },
  {
    href: '/blog/taxi-rotterdam-the-haque-airport',
    title: 'Taxi Rotterdam The Haque Airport: Reliable private transfer guide',
    description: 'Plan your private transfer from Rotterdam The Haque Airport with fixed pricing and travel tips.',
  },
];

import '../../index.css';

const canonical = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '') + '/blog';
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').toString().trim();
const blogIndexSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      name: 'Pickupr Blog',
      url: canonical,
      description: 'Airport transfer guides for Schiphol routes and cross-border private taxi planning.',
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      itemListElement: posts.slice(0, 20).map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: canonical.replace(/\/blog$/, '') + post.href,
        name: post.title,
      })),
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pickupr Blog | Schiphol and airport private transfer guides</title>
    <meta name="description" content="Read practical guides for Schiphol transfers to cities in the Netherlands, Belgium, France, and Germany." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Pickupr Blog | Schiphol and airport private transfer guides" />
    <meta property="og:description" content="Schiphol transfer guides for international travelers who need reliable private taxi service." />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Pickupr Blog | Schiphol and airport private transfer guides" />
    <meta name="twitter:description" content="Schiphol transfer guides for international travelers who need reliable private taxi service." />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(blogIndexSchema)}></script>
  </head>
  <body class="bg-white text-zinc-900">
    <div class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.12),_transparent_34%),linear-gradient(to_bottom,_#f8fafc,_#ffffff_30%)]">
      <header class="sticky top-0 z-20 border-b border-zinc-200 bg-white/90 backdrop-blur-xl">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <a href="/" class="text-xl font-extrabold tracking-tight text-zinc-900">Pickupr</a>
          <nav class="flex items-center gap-5 text-sm font-medium">
            <a href="/" class="text-zinc-600 transition hover:text-zinc-900">Home</a>
            <a href="/blog" class="text-zinc-900">Blog</a>
            <a href="/" class="rounded-full bg-emerald-600 px-4 py-2 text-white transition hover:bg-emerald-500">Book Ride</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-6 py-10 md:py-14">
        <section class="rounded-3xl border border-zinc-200 bg-white p-8 shadow-[0_20px_55px_-35px_rgba(15,23,42,0.24)] md:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-600">Travel journal</p>
          <h1 class="mt-3 text-3xl font-bold leading-tight text-zinc-900 md:text-5xl">Airport taxi & private transfer guides</h1>
          <p class="mt-5 max-w-3xl text-lg leading-relaxed text-zinc-600">Practical articles for international travelers: clear tips, routes, and quick actions to book your ride directly from the homepage.</p>
        </section>

        <section class="mt-6 rounded-3xl border border-zinc-200 bg-white p-6 shadow-[0_20px_50px_-35px_rgba(15,23,42,0.18)]">
          <h2 class="text-xl font-bold text-zinc-900">Popular route categories</h2>
          <div class="mt-4 flex flex-wrap gap-2.5">
            <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700">Schiphol to Netherlands</span>
            <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-sky-700">Schiphol to Belgium</span>
            <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700">Schiphol to France</span>
            <span class="rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700">Schiphol to Germany</span>
            <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-zinc-700">Airport transfer tips</span>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <a href="/schiphol-airport-to-brussels-taxi" class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700 transition hover:border-emerald-300 hover:bg-emerald-100">Schiphol to Brussels taxi</a>
            <a href="/schiphol-airport-to-antwerp-taxi" class="rounded-2xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-700 transition hover:border-sky-300 hover:bg-sky-100">Schiphol to Antwerp taxi</a>
            <a href="/schiphol-airport-to-cologne-taxi" class="rounded-2xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-100">Schiphol to Cologne taxi</a>
            <a href="/schiphol-airport-to-paris-taxi" class="rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700 transition hover:border-blue-300 hover:bg-blue-100">Schiphol to Paris taxi</a>
            <a href="/schiphol-airport-to-rotterdam-taxi" class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-700 transition hover:border-zinc-300 hover:bg-zinc-100">Schiphol to Rotterdam taxi</a>
          </div>
        </section>

        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
          {posts.map((post, index) => (
            <a
              href={post.href}
              class="group relative overflow-hidden rounded-3xl border border-zinc-200 bg-white p-7 shadow-[0_20px_55px_-40px_rgba(15,23,42,0.25)] transition duration-300 hover:-translate-y-1 hover:border-emerald-300"
            >
              <div class="absolute -right-10 -top-10 h-24 w-24 rounded-full bg-emerald-100 blur-2xl transition group-hover:bg-emerald-200"></div>
              <span class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-700">Guide {index + 1}</span>
              <h2 class="mt-4 text-2xl font-bold leading-snug text-zinc-900 transition group-hover:text-emerald-700">{post.title}</h2>
              <p class="mt-4 text-zinc-600">{post.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700">
                Read article
                <span aria-hidden="true">-></span>
              </span>
            </a>
          ))}
        </div>

        <section class="mt-8 rounded-3xl border border-emerald-200 bg-gradient-to-r from-emerald-50 to-sky-50 p-7 shadow-[0_20px_50px_-35px_rgba(16,185,129,0.30)] md:p-8">
          <h2 class="text-2xl font-bold text-zinc-900">Need a transfer today?</h2>
          <p class="mt-2 text-zinc-600">Get a fixed-price quote and complete your reservation directly from the homepage booking flow.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/" class="rounded-full bg-emerald-600 px-5 py-2.5 font-semibold text-white transition hover:bg-emerald-500">Go to homepage and book</a>
            <a href="/services" class="rounded-full border border-zinc-300 bg-white px-5 py-2.5 font-semibold text-zinc-700 transition hover:bg-zinc-100">Explore services</a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
