---
import App from '../App.tsx';
import '../index.css';
import { isCityLandingPath } from '../lib/cityLandingRoutes';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogType?: string;
  keywords?: string[] | string;
  structuredData?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogType = 'website',
  keywords,
  structuredData = null,
} = Astro.props;

const siteBase = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '');
const { canonicalPath, isAliasCanonical } = (() => {
  if (!canonical.startsWith('/')) {
    return { canonicalPath: canonical, isAliasCanonical: false };
  }

  const trimmed = canonical.replace(/\/$/, '') || '/';
  const looksLikeAlias = /^\/(amsterdam|schiphol)-to-[^/]+$/i.test(trimmed);
  const preferredTaxiPath = `${trimmed}-taxi`;

  if (looksLikeAlias && isCityLandingPath(preferredTaxiPath)) {
    return { canonicalPath: preferredTaxiPath, isAliasCanonical: true };
  }

  return { canonicalPath: trimmed, isAliasCanonical: false };
})();
const canonicalUrl = canonicalPath.startsWith('http') ? canonicalPath : (siteBase ? `${siteBase}${canonicalPath}` : canonicalPath);
const heroImagePath = '/hero-airport-transfer.jpg';
const heroImageUrl = siteBase ? `${siteBase}${heroImagePath}` : heroImagePath;
const pageTopic = title.replace(/\s*\|\s*Pickupr\s*$/i, '').trim() || 'Private transfer service';
const normalizedPath = canonicalPath.replace(/^https?:\/\/[^/]+/i, '').replace(/\/$/, '') || '/';
const slugWords = normalizedPath
  .replace(/^\//, '')
  .split('-')
  .filter(Boolean)
  .slice(0, 8)
  .map((word) => word.toLowerCase());
const defaultKeywords = Array.from(
  new Set([
    pageTopic,
    `${pageTopic} booking`,
    'private transfer',
    'airport transfer',
    'chauffeur service',
    ...slugWords,
  ])
).filter(Boolean);
const keywordList = Array.isArray(keywords)
  ? keywords.filter(Boolean)
  : typeof keywords === 'string'
    ? keywords.split(',').map((part) => part.trim()).filter(Boolean)
    : defaultKeywords;
const keywordContent = keywordList.join(', ');
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').toString().trim();
const normalizedRobots = robots.toLowerCase();
const robotsContent = isAliasCanonical && !normalizedRobots.includes('noindex')
  ? 'noindex, follow'
  : robots;
const webPageSchema = {
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pickupr',
    url: siteBase || undefined,
  },
};

const jsonLdPayload = (() => {
  if (!structuredData) {
    return {
      '@context': 'https://schema.org',
      '@graph': [webPageSchema],
    };
  }

  const data = structuredData as Record<string, unknown>;
  const graph = Array.isArray(data['@graph']) ? (data['@graph'] as unknown[]) : null;

  if (graph) {
    return {
      '@context': (data['@context'] as string) || 'https://schema.org',
      '@graph': [webPageSchema, ...graph],
    };
  }

  return {
    '@context': (data['@context'] as string) || 'https://schema.org',
    '@graph': [webPageSchema, data],
  };
})();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hrefLang="en" href={canonicalUrl} />
    <link rel="alternate" hrefLang="x-default" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageUrl} />

    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)}></script>
  </head>
  <body>
    <App client:load initialPath={normalizedPath} />
  </body>
</html>
