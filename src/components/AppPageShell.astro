---
import App from '../App.tsx';
import '../index.css';
import { getCityRouteByPath } from '../lib/cityLandingRoutes';
import { getKeywordLandingRouteByPath } from '../lib/keywordLandingRoutes';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogType?: string;
  keywords?: string[] | string;
  structuredData?: Record<string, unknown> | null;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogType = 'website',
  keywords,
  structuredData = null,
} = Astro.props;

const siteBase = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '');
const canonicalPath = canonical.startsWith('/') ? (canonical.replace(/\/$/, '') || '/') : canonical;
const canonicalUrl = canonicalPath.startsWith('http') ? canonicalPath : (siteBase ? `${siteBase}${canonicalPath}` : canonicalPath);
const heroImagePath = '/hero-airport-transfer.jpg';
const heroImageUrl = siteBase ? `${siteBase}${heroImagePath}` : heroImagePath;
const pageTopic = title.replace(/\s*\|\s*Pickupr\s*$/i, '').trim() || 'Private transfer service';
const normalizedPath = canonicalPath.replace(/^https?:\/\/[^/]+/i, '').replace(/\/$/, '') || '/';
const shouldEagerHydrate =
  normalizedPath.startsWith('/booking') ||
  normalizedPath === '/admin' ||
  normalizedPath === '/login' ||
  normalizedPath === '/customer' ||
  normalizedPath === '/register' ||
  normalizedPath.startsWith('/rate/');
const slugWords = normalizedPath
  .replace(/^\//, '')
  .split('-')
  .filter(Boolean)
  .slice(0, 8)
  .map((word) => word.toLowerCase());
const defaultKeywords = Array.from(
  new Set([
    pageTopic,
    `${pageTopic} booking`,
    'private transfer',
    'airport transfer',
    'chauffeur service',
    ...slugWords,
  ])
).filter(Boolean);
const keywordList = Array.isArray(keywords)
  ? keywords.filter(Boolean)
  : typeof keywords === 'string'
    ? keywords.split(',').map((part) => part.trim()).filter(Boolean)
    : defaultKeywords;
const keywordContent = keywordList.join(', ');
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').toString().trim();
const googleAdsTagId = 'AW-11308826939';
const robotsContent = robots;
const webPageSchema = {
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Pickupr',
    url: siteBase || undefined,
  },
};

const cityRoute = getCityRouteByPath(normalizedPath);
const keywordRoute = cityRoute ? null : getKeywordLandingRouteByPath(normalizedPath);

const landingKeyword = cityRoute
  ? `${cityRoute.origin} to ${cityRoute.city} Taxi`
  : keywordRoute?.keyword || null;

const landingFaqSchema = landingKeyword
  ? {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: `How much does ${landingKeyword} cost?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: cityRoute
              ? `Typical pricing starts from EUR ${cityRoute.priceFrom}. Final pricing is confirmed before checkout based on route, schedule, and vehicle type.`
              : `Pricing is fixed before confirmation and depends on route, schedule, and selected vehicle type.`,
          },
        },
        {
          '@type': 'Question',
          name: `Can I pre-book ${landingKeyword} with flight monitoring?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. You can pre-book online and include full trip details to receive confirmation and support for schedule changes.',
          },
        },
        {
          '@type': 'Question',
          name: `Is ${landingKeyword} private or shared?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'All bookings are private transfers with a dedicated vehicle for your reservation only.',
          },
        },
        {
          '@type': 'Question',
          name: `Can I add a return trip in the same booking flow?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Return trip details can be added in the same reservation flow during booking.',
          },
        },
      ],
    }
  : null;

const landingServiceSchema = landingKeyword
  ? {
      '@type': 'Service',
      name: landingKeyword,
      description,
      provider: {
        '@type': 'Organization',
        name: 'Pickupr',
        url: siteBase || '/',
      },
      serviceType: cityRoute ? 'Private airport and city-to-city transfer' : 'Private transfer service',
      areaServed: cityRoute ? [cityRoute.countryName, cityRoute.city, 'Netherlands'] : ['Netherlands', 'Belgium', 'Germany', 'France'],
      offers: {
        '@type': 'Offer',
        priceCurrency: 'EUR',
        price: cityRoute ? String(cityRoute.priceFrom) : undefined,
        availability: 'https://schema.org/InStock',
        url: canonicalUrl,
      },
    }
  : null;

const landingHowToSchema = landingKeyword
  ? {
      '@type': 'HowTo',
      name: `How to book ${landingKeyword}`,
      description: `Step-by-step booking process for ${landingKeyword}.`,
      totalTime: 'PT3M',
      step: [
        {
          '@type': 'HowToStep',
          name: 'Enter your route details',
          text: 'Provide pickup, drop-off, date, time, passengers, and luggage.',
        },
        {
          '@type': 'HowToStep',
          name: 'Review fixed fare details',
          text: 'Check pricing, trip details, and transfer type before confirmation.',
        },
        {
          '@type': 'HowToStep',
          name: 'Confirm your booking',
          text: 'Complete the booking and receive transfer confirmation.',
        },
      ],
    }
  : null;

const landingExtraGraph = [landingServiceSchema, landingFaqSchema, landingHowToSchema].filter(Boolean);

const jsonLdPayload = (() => {
  if (!structuredData) {
    return {
      '@context': 'https://schema.org',
      '@graph': [webPageSchema, ...landingExtraGraph],
    };
  }

  const data = structuredData as Record<string, unknown>;
  const graph = Array.isArray(data['@graph']) ? (data['@graph'] as unknown[]) : null;

  if (graph) {
    return {
      '@context': (data['@context'] as string) || 'https://schema.org',
      '@graph': [webPageSchema, ...graph, ...landingExtraGraph],
    };
  }

  return {
    '@context': (data['@context'] as string) || 'https://schema.org',
    '@graph': [webPageSchema, data, ...landingExtraGraph],
  };
})();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hrefLang="en" href={canonicalUrl} />
    <link rel="alternate" hrefLang="x-default" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Pickupr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageUrl} />

    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsTagId}`}></script>
    <script is:inline define:vars={{ googleAdsTagId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', googleAdsTagId);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)}></script>
  </head>
  <body>
    {shouldEagerHydrate ? (
      <App client:load initialPath={normalizedPath} />
    ) : (
      <App client:idle initialPath={normalizedPath} />
    )}
  </body>
</html>
