---
import AppPageShell from './AppPageShell.astro';
import { getCityRouteByPath } from '../lib/cityLandingRoutes';

interface Props {
  pathname?: string;
}

const normalizePathname = (value: string): string => {
  const withoutQuery = value.split('?')[0].split('#')[0] || '/';
  if (withoutQuery.length > 1 && withoutQuery.endsWith('/')) {
    return withoutQuery.slice(0, -1);
  }
  return withoutQuery || '/';
};

const { pathname: pathnameProp } = Astro.props as Props;
const resolvedPathname = normalizePathname(Astro.url?.pathname || pathnameProp || '/');
const route = getCityRouteByPath(resolvedPathname);

if (!route) {
  throw new Error(`Unknown city route path: ${resolvedPathname}`);
}

const isTaxiVariant = resolvedPathname.endsWith('-taxi');
const originLabel = route.pattern === 'schiphol' ? 'Schiphol Airport' : 'Amsterdam';
const pageKeyword = isTaxiVariant
  ? `${originLabel} to ${route.city} Taxi`
  : `${originLabel} to ${route.city} Private Transfer`;

function buildTitle(): string {
  const primary = isTaxiVariant
    ? `${originLabel} to ${route.city} Taxi | Fixed Fare | Pickupr`
    : `${originLabel} to ${route.city} Private Transfer | Pickupr`;

  if (primary.length <= 64) {
    return primary;
  }

  const fallback = `${originLabel} to ${route.city} | Pickupr`;
  return fallback.length <= 64 ? fallback : `${route.city} Transfer | Pickupr`;
}

function buildDescription(): string {
  const primary = isTaxiVariant
    ? `Book ${pageKeyword} with fixed fare, private door-to-door ride, and direct confirmation for ${route.countryName} travel.`
    : `Reserve ${pageKeyword} with private chauffeur comfort, transparent pricing, and direct booking from ${originLabel}.`;

  if (primary.length <= 160) {
    return primary;
  }

  const secondary = isTaxiVariant
    ? `${pageKeyword} from ${originLabel} to ${route.city} with fixed pricing, private transfer, and instant online confirmation.`
    : `${pageKeyword} from ${originLabel} to ${route.city} with private service and direct online reservation.`;

  if (secondary.length <= 160) {
    return secondary;
  }

  return `Private transfer from ${originLabel} to ${route.city} with fixed pricing and direct online confirmation from Pickupr.`;
}

const title = buildTitle();
const description = buildDescription();
// Keep canonical aligned with the actual visited page path.
const canonical = resolvedPathname;
const keywords = [
  pageKeyword,
  `${route.origin} to ${route.city} transfer`,
  `${route.origin} to ${route.city} private taxi`,
  `${route.origin} to ${route.city} private transfer`,
  `${route.city} airport transfer`,
  'fixed price transfer',
];

const faqTravelQuestion = route.pattern === 'schiphol'
  ? `How long does ${route.origin} to ${route.city} usually take?`
  : `What is the estimated travel time from Amsterdam to ${route.city}?`;

const faqTravelAnswer = route.pattern === 'schiphol'
  ? `Typical duration is around ${route.durationMin} minutes depending on traffic conditions.`
  : `Estimated duration is around ${route.durationMin} minutes depending on road and border conditions.`;

const serviceType = route.pattern === 'schiphol'
  ? 'Private airport transfer'
  : 'Private international transfer';

const areaServed = route.pattern === 'schiphol'
  ? ['Netherlands', route.city]
  : [route.countryName, route.city];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: pageKeyword,
      provider: { '@type': 'Organization', name: 'Pickupr', url: '/' },
      areaServed,
      serviceType,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'EUR',
        price: String(route.priceFrom),
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: `Can I pre-book ${route.keyword}?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. You can pre-book online and receive direct confirmation with clear route details.',
          },
        },
        {
          '@type': 'Question',
          name: faqTravelQuestion,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faqTravelAnswer,
          },
        },
      ],
    },
  ],
};
---

<AppPageShell
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  structuredData={structuredData}
/>
