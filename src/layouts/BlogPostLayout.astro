---
interface Props {
  title: string;
  description: string;
  canonical: string;
  publishDate: string;
  updatedDate?: string;
  keyword: string;
}

import '../index.css';

const { title, description, canonical, publishDate, updatedDate, keyword } = Astro.props;
const siteBase = (import.meta.env.SITE || import.meta.env.PUBLIC_SITE_URL || '').toString().replace(/\/$/, '');
const canonicalUrl = canonical.startsWith('http') ? canonical : (siteBase ? `${siteBase}${canonical}` : canonical);
const isoPublished = new Date(publishDate).toISOString();
const isoUpdated = new Date(updatedDate || publishDate).toISOString();
const faqItems = [
  {
    question: `How far in advance should I book a ${keyword} transfer?`,
    answer: 'For best availability, book as early as possible. Same-day bookings can be available depending on route demand and driver capacity.',
  },
  {
    question: 'Is airport waiting time included in private transfer bookings?',
    answer: 'Yes, airport transfer services typically include a waiting window to account for normal delays and baggage collection time.',
  },
  {
    question: 'Can I get a fixed price before confirming my booking?',
    answer: 'Yes. You should always review a clear fixed or transparent fare summary before confirming your reservation.',
  },
];
const relatedPosts = [
  { href: '/blog/schiphol-airport-to-rotterdam-private-transfer', label: 'Schiphol to Rotterdam private transfer' },
  { href: '/blog/schiphol-airport-to-brussels-private-transfer', label: 'Schiphol to Brussels private transfer' },
  { href: '/blog/schiphol-airport-to-cologne-private-transfer', label: 'Schiphol to Cologne private transfer' },
  { href: '/blog/schiphol-airport-to-paris-private-transfer', label: 'Schiphol to Paris private transfer' },
  { href: '/blog/taxi-amsterdam-airport', label: 'Taxi Amsterdam Airport guide' },
];
const relatedForPage = relatedPosts.filter((post) => !canonical.includes(post.href.replace('/blog/', ''))).slice(0, 4);
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').toString().trim();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: isoPublished,
        dateModified: isoUpdated,
        mainEntityOfPage: canonicalUrl,
        author: { '@type': 'Organization', name: 'Pickupr' },
        publisher: { '@type': 'Organization', name: 'Pickupr' },
        keywords: [keyword, 'private transfer', 'private taxi', 'airport taxi'],
      })}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    ></script>
  </head>
  <body class="bg-white text-zinc-900">
    <div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.10),_transparent_35%),linear-gradient(to_bottom,_#f8fafc,_#ffffff_35%)]">
      <header class="sticky top-0 z-20 border-b border-zinc-200 bg-white/90 backdrop-blur-xl">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <a href="/" class="text-xl font-bold tracking-tight text-zinc-900">Pickupr</a>
          <nav class="flex items-center gap-5 text-sm font-medium">
            <a href="/" class="text-zinc-600 transition hover:text-zinc-900">Home</a>
            <a href="/blog" class="text-zinc-900">Blog</a>
            <a href="/" class="rounded-full bg-emerald-600 px-4 py-2 text-white transition hover:bg-emerald-500">Book Ride</a>
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-4xl px-6 py-10 md:py-14">
        <section class="rounded-3xl border border-zinc-200 bg-white p-8 shadow-[0_20px_55px_-35px_rgba(15,23,42,0.24)] backdrop-blur md:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600">Airport transfer blog</p>
          <h1 class="mt-3 text-3xl font-bold leading-tight text-zinc-900 md:text-5xl">{title}</h1>
          <p class="mt-5 text-lg leading-relaxed text-zinc-600">{description}</p>
          <div class="mt-6 inline-flex rounded-full border border-zinc-200 bg-zinc-50 px-4 py-2 text-sm text-zinc-600">
            Published: {publishDate}{updatedDate ? ` | Updated: ${updatedDate}` : ''}
          </div>
        </section>

        <article class="blog-article mt-8 rounded-3xl border border-zinc-200 bg-white p-7 shadow-[0_30px_80px_-55px_rgba(15,23,42,0.25)] md:p-10">
          <slot />
        </article>

        <section class="mt-8 rounded-3xl border border-zinc-200 bg-white p-7 shadow-[0_20px_55px_-40px_rgba(15,23,42,0.24)] md:p-8">
          <h2 class="text-2xl font-bold text-zinc-900">Frequently asked questions</h2>
          <div class="mt-4 space-y-4">
            {faqItems.map((item) => (
              <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4">
                <h3 class="text-base font-semibold text-zinc-900">{item.question}</h3>
                <p class="mt-2 text-sm leading-relaxed text-zinc-600">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="mt-8 rounded-3xl border border-zinc-200 bg-white p-7 shadow-[0_20px_55px_-40px_rgba(15,23,42,0.24)] md:p-8">
          <h2 class="text-2xl font-bold text-zinc-900">Related transfer guides</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {relatedForPage.map((post) => (
              <a href={post.href} class="rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-700 transition hover:border-emerald-300 hover:text-emerald-700">
                {post.label}
              </a>
            ))}
          </div>
        </section>

        <section class="mt-8 rounded-3xl border border-emerald-200 bg-gradient-to-r from-emerald-50 to-sky-50 p-7 shadow-[0_20px_55px_-35px_rgba(16,185,129,0.30)] md:p-8">
          <h2 class="text-2xl font-bold text-zinc-900">Ready to book?</h2>
          <p class="mt-2 text-zinc-600">Go to the homepage and book your ride directly with fixed pricing and professional drivers.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/" class="rounded-full bg-emerald-600 px-5 py-2.5 font-semibold text-white transition hover:bg-emerald-500">Go to homepage to book</a>
            <a href="/services" class="rounded-full border border-zinc-300 bg-white px-5 py-2.5 font-semibold text-zinc-700 transition hover:bg-zinc-100">View services</a>
          </div>
        </section>
      </main>

      <div class="fixed inset-x-0 bottom-0 z-40 px-4 pb-4 md:hidden">
        <div class="mx-auto max-w-md rounded-2xl border border-emerald-200 bg-white/95 p-2.5 shadow-[0_18px_40px_-30px_rgba(16,185,129,0.45)] backdrop-blur">
          <a href="/" class="block w-full rounded-xl bg-emerald-600 px-5 py-3 text-center text-sm font-bold text-white transition hover:bg-emerald-500">
            Book Your Ride Now
          </a>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .blog-article :global(p) {
    margin-top: 1.1rem;
    line-height: 1.9;
    color: rgb(82 82 91);
    font-size: 1.04rem;
  }

  .blog-article :global(h2) {
    margin-top: 2.4rem;
    margin-bottom: 0.7rem;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: rgb(24 24 27);
  }

  .blog-article :global(ul),
  .blog-article :global(ol) {
    margin-top: 1rem;
    margin-bottom: 1.4rem;
    padding-left: 1.3rem;
    color: rgb(82 82 91);
  }

  .blog-article :global(li) {
    margin: 0.6rem 0;
    line-height: 1.75;
  }

  .blog-article :global(a) {
    color: rgb(4 120 87);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-article :global(strong) {
    color: rgb(24 24 27);
  }
</style>
